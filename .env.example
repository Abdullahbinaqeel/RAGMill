# RAGMill configuration — copy to `.env` and fill in as needed.
# All variables are optional; sensible defaults apply. `.env` is git-ignored.

# ── Core ────────────────────────────────────────────────────────────────────
RAGMILL_CHUNK_SIZE=500
RAGMILL_OVERLAP=50
RAGMILL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
RAGMILL_EMBEDDING_DIM=384

# ── Vector store: sqlite (default) | pinecone | qdrant ──────────────────────
RAGMILL_STORE_TYPE=sqlite
RAGMILL_SQLITE_PATH=./ragmill.db

# Pinecone (RAGMILL_STORE_TYPE=pinecone)
# RAGMILL_PINECONE_API_KEY=
# RAGMILL_PINECONE_ENVIRONMENT=us-west-2
# RAGMILL_PINECONE_INDEX_NAME=ragmill

# Qdrant (RAGMILL_STORE_TYPE=qdrant)
# RAGMILL_QDRANT_URL=http://localhost:6333
# RAGMILL_QDRANT_API_KEY=
# RAGMILL_QDRANT_COLLECTION_NAME=ragmill
# RAGMILL_QDRANT_PREFER_GRPC=false

# ── Chat backend: local (default) | gemini | openai ─────────────────────────
RAGMILL_CHAT_BACKEND=local
RAGMILL_CHAT_MODEL_REPO=Qwen/Qwen2.5-1.5B-Instruct-GGUF
RAGMILL_CHAT_MODEL_FILE=qwen2.5-1.5b-instruct-q4_k_m.gguf
RAGMILL_CHAT_N_CTX=4096
# GEMINI_API_KEY=
# RAGMILL_GEMINI_MODEL=gemini-flash-latest
# OPENAI_API_KEY=
# RAGMILL_OPENAI_MODEL=gpt-4o-mini

# ── REST server ─────────────────────────────────────────────────────────────
RAGMILL_HOST=127.0.0.1
RAGMILL_PORT=8000
# Require an X-API-Key header on all endpoints except /health:
# RAGMILL_API_KEY=
# Restrict which directories /ingest and /sync may read (colon-separated):
# RAGMILL_ALLOWED_ROOTS=/data/docs:/data/pdfs
